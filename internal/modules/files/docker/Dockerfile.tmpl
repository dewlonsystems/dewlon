# syntax=docker/dockerfile:1

FROM golang:{{GO_VERSION}}-alpine AS build
WORKDIR /src

# Copy the module files first so the dependency layer stays cached
# until go.mod or go.sum actually change.
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/{{PROJECT_NAME}} {{MAIN_PACKAGE}}

# Distroless has no shell or package manager, which keeps the image small
# and leaves little for an attacker to work with.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/{{PROJECT_NAME}} /app
USER nonroot:nonroot
ENTRYPOINT ["/app"]